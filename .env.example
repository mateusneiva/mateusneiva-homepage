# Optional: import the same Medium feed in both languages.
MEDIUM_USERNAME=

# Optional: language-specific feeds take precedence over MEDIUM_USERNAME.
# Example: https://medium.com/feed/@your-username
MEDIUM_FEED_PT=
MEDIUM_FEED_EN=

# Optional: show the owner's Spotify activity in About (server-side credentials).
# Set CLIENT_ID and CLIENT_SECRET, then run `pnpm spotify:auth` for REFRESH_TOKEN.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Contact form: server-side Resend credentials (also configure these in Vercel).
RESEND_API_KEY=
# Use a sender address on a domain verified in Resend.
CONTACT_EMAIL_FROM=
CONTACT_EMAIL_TO=mateus.fneiva@gmail.com
